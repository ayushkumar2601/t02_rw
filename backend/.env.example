# Environment Configuration Example for Ava Inbound Voice Agent
# Copy this file to .env and adjust settings as needed.
# Operating in $0 / free mode does NOT require a paid API key.

# Runtime environment (development / production)
ENVIRONMENT=development
DEBUG=false

# LLM Configuration (Groq free developer tier)
# If empty, the system automatically falls back to deterministic NLP extraction
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=8.0
LLM_MAX_RETRIES=2

# Database Path (SQLite)
DATABASE_PATH=leads.db

# State Machine Policies
MAX_CLARIFICATION_ATTEMPTS=2

# CORS (Frontend origins allowed for Phase 2)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
